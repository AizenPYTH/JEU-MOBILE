                },
                {
                  "kind": "trust",
                  "npc": "lacaze",
                  "amount": 1
                }
              ],
              "next": "p_dutiful"
            },
            {
              "id": "c01_silent",
              "text": "Ne rien dire",
              "kind": "narrative",
              "silent": true,
              "pause": 2,
              "remember": "Vous n'avez rien répondu à Lacaze, et il a levé les yeux.",
              "shot": {
                "kind": "closeUp",
                "camera": "cam_lac_cu",
                "subject": "lacaze"
              },
              "effects": [
                {
                  "kind": "flag",
                  "flag": "c01_silent"
                }
              ]
            }
          ]
        },
        {
          "id": "p_defiant",
          "speaker": "player",
          "text": "Et vous, vous l'auriez demandé ?",
