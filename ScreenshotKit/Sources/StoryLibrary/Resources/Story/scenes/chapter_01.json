      "dialogue": [
        {
          "id": "l_close_door",
          "speaker": "lacaze",
          "text": "{player.lastName}. Fermez la porte.",
          "emotion": "tired"
        },
        {
          "id": "l_twelve_years",
          "speaker": "lacaze",
          "text": "Douze ans de terrain. Vous êtes là parce qu'on me l'a demandé.",
          "emotion": "neutral",
          "choices": [
            {
              "id": "c01_defiant",
              "text": "Et vous, vous l'auriez demandé ?",
              "kind": "relational",
              "remember": "Vous avez demandé à Lacaze s'il vous aurait {g:choisi|choisie|choisi}.",
              "shot": {
                "kind": "overShoulder",
                "camera": "cam_lac_os",
                "subject": "player",
                "other": "lacaze"
              },
              "effects": [
                {
                  "kind": "flag",
