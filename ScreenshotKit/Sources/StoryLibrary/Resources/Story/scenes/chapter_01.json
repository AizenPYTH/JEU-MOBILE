                  "npc": "lacaze",
                  "amount": 1
                }
              ],
              "next": "p_defiant"
            },
            {
              "id": "c01_dutiful",
              "text": "Je ferai le travail.",
              "kind": "relational",
              "remember": "Vous avez promis à Lacaze de faire le travail.",
              "shot": {
                "kind": "overShoulder",
                "camera": "cam_lac_os",
                "subject": "player",
                "other": "lacaze"
              },
              "effects": [
                {
