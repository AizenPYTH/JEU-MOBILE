      "dialogue": [
        {
          "id": "i_hello",
          "speaker": "ines",
          "text": "Vous êtes {player.lastName}. Deux secondes.",
          "emotion": "neutral",
          "animation": "typing"
        },
        {
          "id": "i_extracted",
          "speaker": "ines",
          "text": "Le téléphone de Maëlle Rocher. Extrait samedi, copie intégrale.",
          "emotion": "neutral",
          "next": "i_rule"
        },
        {
          "id": "i_rule",
          "speaker": "ines",
          "text": "Personne ne touche un téléphone saisi avant moi. Pas même Lacaze.",
          "emotion": "amused",
          "shot": {
            "kind": "closeUp",
            "camera": "cam_os_ines_cu",
            "subject": "ines"
          }
        },
        {
          "id": "a_new",
          "speaker": "aubrac",
          "text": "C'est donc vous, {g:le nouveau|la nouvelle|le nouvel agent} de Lacaze.",
          "emotion": "neutral"
        },
        {
          "id": "a_marseille",
          "speaker": "aubrac",
          "text": "Un dossier à Marseille, et on vous confie déjà celui-là.",
          "emotion": "tired"
        },
        {
          "id": "i_varin",
          "speaker": "ines",
          "text": "Atelier Varin. Des architectes, rue de la Folie-Méricourt, dans le 11ᵉ.",
          "emotion": "neutral",
          "next": "i_contest"
        },
        {
          "id": "i_contest",
          "speaker": "ines",
          "text": "Un concours public : la médiathèque de Montreuil. Leur dossier partait vendredi avant midi.",
          "emotion": "neutral",
          "next": "a_laurier"
        },
        {
          "id": "a_laurier",
          "speaker": "aubrac",
          "text": "Vendredi à neuf heures, un concurrent dépose presque le même projet. Laurier & Fils.",
          "emotion": "neutral",
          "shot": {
            "kind": "medium",
            "camera": "cam_os_aubrac_turn",
            "subject": "aubrac"
          }
        },
        {
          "id": "i_alarm",
          "speaker": "ines",
          "text": "Le journal de l'alarme. Jeudi, 22 h 31 : le code de Maëlle Rocher, l'office manager.",
          "emotion": "neutral",
          "next": "i_denies"
        },
        {
          "id": "i_denies",
          "speaker": "ines",
          "text": "Elle dit qu'elle n'y était pas. Elle nous a confié son téléphone elle-même.",
          "emotion": "neutral",
          "shot": {
            "kind": "medium",
            "camera": "cam_os_ines",
            "subject": "ines"
          }
        },
        {
          "id": "a_question",
          "speaker": "aubrac",
          "text": "Quelques minutes sur son téléphone, et vous nous direz qui a ouvert cette porte ?",
          "emotion": "tense",
          "choices": [
            {
              "id": "c02_promise",
              "text": "Oui. Avec les preuves.",
              "kind": "relational",
              "remember": "Vous avez promis un nom à Aubrac avant d'avoir ouvert le téléphone.",
              "shot": {
                "kind": "overShoulder",
                "camera": "cam_os_ots_aubrac",
                "subject": "player",
                "other": "aubrac"
              },
              "effects": [
                {
                  "kind": "flag",
                  "flag": "c02_promised"
                },
                {
                  "kind": "respect",
                  "npc": "aubrac",
                  "amount": 1
                }
              ],
              "next": "p_promise"
            },
            {
              "id": "c02_phone",
              "text": "Je vous dirai ce que dit le téléphone.",
              "kind": "relational",
              "remember": "Vous avez répondu à Aubrac que le téléphone parlerait pour vous.",
              "shot": {
                "kind": "overShoulder",
                "camera": "cam_os_ots_aubrac",
                "subject": "player",
                "other": "aubrac"
              },
              "effects": [
                {
                  "kind": "flag",
                  "flag": "c02_phone_speaks"
                },
                {
                  "kind": "trust",
                  "npc": "ines",
                  "amount": 1
                }
              ],
              "next": "p_phone"
            },
            {
              "id": "c02_quiet",
              "text": "Ne rien dire",
              "kind": "narrative",
              "silent": true,
              "pause": 2,
              "remember": "Vous avez laissé Aubrac douter, sans lui répondre.",
              "shot": {
                "kind": "closeUp",
                "camera": "cam_os_aubrac_cu",
                "subject": "aubrac"
              },
              "effects": [
                {
                  "kind": "flag",
                  "flag": "c02_silent_aubrac"
                }
              ],
              "next": "a_quiet"
            }
          ]
        },
        {
          "id": "p_promise",
          "speaker": "player",
          "text": "Oui. Avec les preuves.",
          "next": "a_note"
        },
        {
          "id": "a_note",
          "speaker": "aubrac",
          "text": "Alors je note l'heure.",
          "emotion": "neutral",
          "shot": {
            "kind": "closeUp",
            "camera": "cam_os_aubrac_cu",
            "subject": "aubrac"
          }
        },
        {
          "id": "p_phone",
          "speaker": "player",
          "text": "Je vous dirai ce que dit le téléphone.",
          "next": "i_good"
        },
        {
          "id": "i_good",
          "speaker": "ines",
          "text": "Bonne réponse.",
          "emotion": "amused",
          "shot": {
            "kind": "closeUp",
            "camera": "cam_os_ines_cu",
            "subject": "ines"
          },
          "next": "a_shrug"
        },
        {
          "id": "a_shrug",
          "speaker": "aubrac",
          "text": "Un téléphone dit ce qu'on veut bien y lire.",
          "emotion": "neutral",
          "animation": "shrug",
          "shot": {
            "kind": "medium",
            "camera": "cam_os_aubrac_turn",
            "subject": "aubrac"
          }
        },
        {
          "id": "a_quiet",
          "speaker": "aubrac",
          "text": "Au moins, vous ne promettez rien.",
          "emotion": "neutral"
        },
        {
          "id": "i_lacaze",
          "speaker": "ines",
          "text": "Je l'ai remis sous scellé. Lacaze vous attend, bureau 312.",
          "emotion": "neutral"
        }
      ]
    },
