      "dialogue": [
        {
          "id": "l_enter",
          "speaker": "lacaze",
          "text": "Entrez. Asseyez-vous.",
          "emotion": "tired"
        },
        {
          "id": "l_heard_promise",
          "speaker": "lacaze",
          "text": "Aubrac m'a dit que vous lui aviez promis un nom.",
          "emotion": "neutral",
          "condition": {
            "flag": "c02_promised"
          },
          "next": "l_heard_phone"
        },
        {
          "id": "l_heard_phone",
          "speaker": "lacaze",
          "text": "Inès dit que vous écoutez. Elle ne le dit de personne.",
          "emotion": "neutral",
          "condition": {
            "flag": "c02_phone_speaks"
          },
          "next": "l_heard_quiet"
        },
        {
          "id": "l_heard_quiet",
          "speaker": "lacaze",
          "text": "Aubrac dit que vous ne répondez pas. Ici, ce n'est pas un défaut.",
          "emotion": "neutral",
          "condition": {
            "flag": "c02_silent_aubrac"
          }
        },
        {
          "id": "l_plans",
          "speaker": "lacaze",
          "text": "Des plans d'architecte. Pas de mort, pas de sang.",
          "emotion": "tired",
          "next": "l_money"
        },
        {
          "id": "l_money",
          "speaker": "lacaze",
          "text": "Mais un concours public, et des mois de travail sortis en une nuit.",
          "emotion": "neutral",
          "next": "l_questions"
        },
        {
          "id": "l_questions",
          "speaker": "lacaze",
          "text": "Des questions ?",
          "emotion": "neutral",
          "choices": [
            {
              "id": "c02_why",
              "text": "Pourquoi le BEN, pour des plans ?",
              "kind": "cosmetic",
              "shot": {
                "kind": "overShoulder",
                "camera": "cam_lac_os",
                "subject": "player",
                "other": "lacaze"
              },
              "next": "p_why"
            },
            {
              "id": "c02_none",
              "text": "Aucune.",
              "kind": "cosmetic",
              "shot": {
                "kind": "overShoulder",
                "camera": "cam_lac_os",
                "subject": "player",
                "other": "lacaze"
              },
              "next": "p_none"
            },
            {
              "id": "c02_q_silent",
              "text": "Ne rien dire",
              "kind": "cosmetic",
              "silent": true,
              "pause": 2,
              "shot": {
                "kind": "closeUp",
                "camera": "cam_lac_cu",
                "subject": "lacaze"
              }
            }
          ]
        },
        {
          "id": "p_why",
          "speaker": "player",
          "text": "Pourquoi le BEN, pour des plans ?",
          "next": "l_why"
        },
        {
          "id": "l_why",
          "speaker": "lacaze",
          "text": "Parce que la seule preuve est dans un téléphone.",
          "emotion": "neutral",
          "shot": {
            "kind": "closeUp",
            "camera": "cam_lac_cu",
            "subject": "lacaze"
          },
          "next": "l_why_2"
        },
        {
          "id": "l_why_2",
          "speaker": "lacaze",
          "text": "Et que les téléphones, ici, on sait les lire.",
          "emotion": "neutral"
        },
        {
          "id": "p_none",
          "speaker": "player",
          "text": "Aucune.",
          "next": "l_fine"
        },
        {
          "id": "l_fine",
          "speaker": "lacaze",
          "text": "Bien.",
          "emotion": "neutral",
          "animation": "nod",
          "shot": {
            "kind": "closeUp",
            "camera": "cam_lac_cu",
            "subject": "lacaze"
          }
        },
        {
          "id": "l_c01_defiant",
          "speaker": "lacaze",
          "text": "Vous m'aviez demandé si je vous aurais {g:choisi|choisie|choisi}. Je ne sais toujours pas.",
          "emotion": "neutral",
          "condition": {
            "flag": "c01_defiant"
          },
          "next": "l_c01_dutiful"
        },
        {
          "id": "l_c01_dutiful",
          "speaker": "lacaze",
          "text": "Vous m'aviez promis de faire le travail. En voilà.",
          "emotion": "neutral",
          "condition": {
            "flag": "c01_dutiful"
          },
          "next": "l_c01_silent"
        },
        {
          "id": "l_c01_silent",
          "speaker": "lacaze",
          "text": "Vous ne parlez toujours pas beaucoup. Gardez ça pour les témoins.",
          "emotion": "neutral",
          "condition": {
            "flag": "c01_silent"
          }
        },
        {
          "id": "l_varin",
          "speaker": "lacaze",
          "text": "Plainte de Sonia Varin, la cofondatrice. Déposée vendredi midi.",
          "emotion": "neutral",
          "next": "l_three"
        },
        {
          "id": "l_three",
          "speaker": "lacaze",
          "text": "Trois noms dans le dossier. Et un code d'alarme qui n'était à aucun d'eux.",
          "emotion": "neutral"
        },
        {
          "id": "l_maelle",
          "speaker": "lacaze",
          "text": "Maëlle Rocher nous a remis son téléphone vendredi, à quinze heures. De son plein gré.",
          "emotion": "neutral",
          "next": "l_not_yet"
        },
        {
          "id": "l_not_yet",
          "speaker": "lacaze",
          "text": "Personne ne la met en cause. Pour l'instant.",
          "emotion": "neutral"
        },
        {
          "id": "l_seal",
          "speaker": "lacaze",
          "text": "Vous signerez le registre des scellés en sortant.",
          "emotion": "neutral",
          "next": "l_phone"
        },
        {
          "id": "l_phone",
          "speaker": "lacaze",
          "text": "Le téléphone de Maëlle Rocher. À vous.",
          "emotion": "neutral"
        }
      ]
    },
