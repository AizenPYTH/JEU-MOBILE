      "dialogue": [
        {
          "id": "a_solved",
          "speaker": "aubrac",
          "text": "Bellec a parlé. Votre rapport tenait.",
          "emotion": "neutral",
          "condition": {
            "lastCaseSolved": true
          },
          "next": "a_unsolved"
        },
        {
          "id": "a_unsolved",
          "speaker": "aubrac",
          "text": "Votre rapport désignait quelqu'un d'autre. Inès a repris la corbeille derrière vous.",
          "emotion": "tired",
          "condition": {
            "lastCaseSolved": false
          },
          "next": "a_unsolved_2"
        },
        {
          "id": "a_unsolved_2",
          "speaker": "aubrac",
          "text": "Bellec est venu à quinze heures. Il a parlé.",
          "emotion": "neutral",
          "condition": {
            "lastCaseSolved": false
          },
          "next": "a_promise_ok"
        },
        {
          "id": "a_promise_ok",
          "speaker": "aubrac",
          "text": "J'avais noté l'heure. Votre nom est arrivé à temps.",
          "emotion": "neutral",
          "condition": {
            "flag": "c02_promised",
            "lastCaseSolved": true
          },
          "shot": {
            "kind": "closeUp",
            "camera": "cam_int_cu",
            "subject": "aubrac"
          },
          "next": "a_promise_ko"
        },
        {
          "id": "a_promise_ko",
          "speaker": "aubrac",
          "text": "J'avais noté l'heure. Le nom n'était pas le bon.",
          "emotion": "tired",
          "condition": {
            "flag": "c02_promised",
            "lastCaseSolved": false
          },
          "shot": {
            "kind": "closeUp",
            "camera": "cam_int_cu",
            "subject": "aubrac"
          },
          "next": "a_debt"
        },
        {
          "id": "a_debt",
          "speaker": "aubrac",
          "text": "Douze mille euros. Il les devait à Olivier Laurier depuis l'an dernier.",
          "emotion": "neutral",
          "shot": {
            "kind": "medium",
            "camera": "cam_int_ms",
            "subject": "aubrac"
          },
          "next": "a_deal"
        },
        {
          "id": "a_deal",
          "speaker": "aubrac",
          "text": "Laurier lui a proposé d'effacer la dette. Contre le dossier Montreuil.",
          "emotion": "neutral"
        },
        {
          "id": "i_quits",
          "speaker": "ines",
          "text": "« On est quittes. » C'était pour Laurier. Il l'a envoyé à Maëlle.",
          "emotion": "neutral",
          "next": "a_deleted"
        },
        {
          "id": "a_deleted",
          "speaker": "aubrac",
          "text": "Une minute plus tard, il l'effaçait. Il croyait que ça suffisait.",
          "emotion": "neutral",
          "shot": {
            "kind": "medium",
            "camera": "cam_int_ms",
            "subject": "aubrac"
          },
          "next": "i_always"
        },
        {
          "id": "i_always",
          "speaker": "ines",
          "text": "Ils le croient tous.",
          "emotion": "amused",
          "shot": {
            "kind": "closeUp",
            "camera": "cam_int_ines_cu",
            "subject": "ines"
          }
        },
        {
          "id": "i_maelle",
          "speaker": "ines",
          "text": "Maëlle Rocher a confirmé. Elle lui a donné son code, puis elle s'est tue.",
          "emotion": "tired",
          "next": "i_afraid"
        },
        {
          "id": "i_afraid",
          "speaker": "ines",
          "text": "Donner son code est interdit, à l'atelier. Elle avait peur pour sa place.",
          "emotion": "tired"
        },
        {
          "id": "a_write",
          "speaker": "aubrac",
          "text": "Elle a donné son code à un homme qui mentait. On l'écrit, dans la synthèse ?",
          "emotion": "tense",
          "choices": [
            {
              "id": "c02_write",
              "text": "Oui. Elle a donné son code.",
              "kind": "relational",
              "remember": "Vous avez fait écrire que Maëlle Rocher avait donné son code.",
              "shot": {
                "kind": "overShoulder",
                "camera": "cam_int_os_suspect",
                "subject": "player",
                "other": "aubrac"
              },
              "effects": [
                {
                  "kind": "flag",
                  "flag": "c02_maelle_written"
                },
                {
                  "kind": "respect",
                  "npc": "aubrac",
                  "amount": 1
                }
              ],
              "next": "p_write"
            },
            {
              "id": "c02_spare",
              "text": "Elle s'est fait avoir. On écrit ça.",
              "kind": "relational",
              "remember": "Vous avez écrit que Maëlle Rocher s'était fait avoir.",
              "shot": {
                "kind": "overShoulder",
                "camera": "cam_int_os_suspect",
                "subject": "player",
                "other": "aubrac"
              },
              "effects": [
                {
                  "kind": "flag",
                  "flag": "c02_maelle_spared"
                },
                {
                  "kind": "trust",
                  "npc": "ines",
                  "amount": 1
                }
              ],
              "next": "p_spare"
            },
            {
              "id": "c02_maelle_silent",
              "text": "Ne rien dire",
              "kind": "narrative",
              "silent": true,
              "pause": 2,
              "remember": "Vous n'avez rien dit quand Aubrac a parlé de Maëlle Rocher.",
              "shot": {
                "kind": "closeUp",
                "camera": "cam_int_cu",
                "subject": "aubrac"
              },
              "effects": [
                {
                  "kind": "flag",
                  "flag": "c02_maelle_silent"
                }
              ],
              "next": "a_facts"
            }
          ]
        },
        {
          "id": "p_write",
          "speaker": "player",
          "text": "Oui. Elle a donné son code.",
          "next": "a_procedure"
        },
        {
          "id": "a_procedure",
          "speaker": "aubrac",
          "text": "C'est la procédure. Le parquet fera le tri.",
          "emotion": "neutral",
          "animation": "nod",
          "shot": {
            "kind": "closeUp",
            "camera": "cam_int_cu",
            "subject": "aubrac"
          }
        },
        {
          "id": "p_spare",
          "speaker": "player",
          "text": "Elle s'est fait avoir. On écrit ça.",
          "next": "i_thanks"
        },
        {
          "id": "i_thanks",
          "speaker": "ines",
          "text": "Merci.",
          "emotion": "warm",
          "shot": {
            "kind": "closeUp",
            "camera": "cam_int_ines_cu",
            "subject": "ines"
          },
          "next": "a_both"
        },
        {
          "id": "a_both",
          "speaker": "aubrac",
          "text": "On écrira les deux. Le parquet choisira.",
          "emotion": "tired",
          "animation": "shrug",
          "shot": {
            "kind": "medium",
            "camera": "cam_int_ms",
            "subject": "aubrac"
          }
        },
        {
          "id": "a_facts",
          "speaker": "aubrac",
          "text": "Alors j'écris les faits. Rien d'autre.",
          "emotion": "neutral"
        },
        {
          "id": "a_sleep",
          "speaker": "aubrac",
          "text": "Rentrez dormir, {player.lastName}. Lacaze lira tout ça demain.",
          "emotion": "tired"
        }
      ]
