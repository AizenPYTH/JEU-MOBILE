    "coming.regulars.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody yet. Regulars arrive as your reputation grows. The first one is often a baker from the neighbourhood…"
