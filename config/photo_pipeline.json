{
  "version": 1,
  "about": "Configuration of the photo asset pipeline (scripts/photos/pipeline.py). Docs: docs/photo_pipeline/PHOTO_PIPELINE.md. Only this file and photo_catalog.json are meant to be edited by hand.",
  "providers": {
    "order": [
      "wikimedia",
      "pexels",
      "openverse"
    ],
    "pexels": {
      "enabled": true,
      "apiKeyEnv": "PEXELS_API_KEY",
      "endpoint": "https://api.pexels.com/v1/search",
      "perPage": 30,
      "minIntervalSeconds": 1.0,
      "download": "large2x",
      "license": "Pexels License",
      "licenseUrl": "https://www.pexels.com/license/"
    },
    "openverse": {
      "enabled": true,
      "endpoint": "https://api.openverse.org/v1/images/",
      "pageSize": 20,
      "minIntervalSeconds": 4.0,
      "licenseType": "commercial,modification",
      "allowedLicenses": [
        "cc0",
        "pdm",
        "by",
        "by-sa"
      ],
      "attributionRequiredFor": [
        "by",
        "by-sa"
      ]
    },
    "wikimedia": {
      "enabled": true,
      "about": "Wikimedia Commons, official MediaWiki API (action=query, generator=search, imageinfo + extmetadata). No key. User-Agent with contact, as Wikimedia asks.",
      "endpoint": "https://commons.wikimedia.org/w/api.php",
      "pageSize": 20,
      "thumbWidth": 1600,
      "minIntervalSeconds": 1.0,
      "allowedLicenses": [
        "cc0",
        "pdm",
        "by",
        "by-sa"
      ],
      "attributionRequiredFor": [
        "by",
        "by-sa"
      ]
    }
  },
  "network": {
    "timeoutSeconds": 30,
    "retries": 3,
    "backoffSeconds": 5,
    "userAgent": "ConcludeEnquetesPhotoPipeline/2.0 (NOREL GAMES; https://github.com/AizenPYTH/JEU-MOBILE)"
  },
  "profiles": {
    "phone-photo": {
      "about": "Every photo of the seized phone: Photos detail (4:3, full width ≈ 390 pt), message bubble (200 × 150 pt), gallery grid (square crop of it at runtime, ≈ 130 pt), Carnet exhibit (≤ 200 pt high), filing sheet (78 pt). One file serves them all; iOS downsamples.",
      "width": 1024,
      "height": 768,
      "quality": 76,
      "format": "jpeg"
    }
  },
